# Port the website listens on
PORT=3000
# Initial admin password. It is used until you change it inside the admin panel (Settings -> Password).
ADMIN_PASSWORD=ganti-password-ini
# Optional: fixed secret for admin sessions (random text). If empty, one is generated and stored in data/secret.json
SESSION_SECRET=
# Time zone used for "today" (patrol schedule, dues date)
TZ_NAME=Asia/Jakarta
# Set to 1 when the site runs behind a reverse proxy / HTTPS (Nginx, Cloudflare, Railway, Render)
TRUST_PROXY=0
# Set to 1 to force the Secure flag on the admin cookie (use with HTTPS)
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Vercel only. On Vercel the admin panel saves changes as commits to your GitHub repository.
# Set these in Vercel: Project Settings -> Environment Variables (not in this file).
# ---------------------------------------------------------------------------
# Repository in the form owner/name (use a PRIVATE repository: residents' suggestions are stored in it)
GITHUB_REPO=
# Fine-grained token with "Contents: Read and write" permission on that repository only
GITHUB_TOKEN=
# Branch that Vercel deploys as production (default main)
GITHUB_BRANCH=main
